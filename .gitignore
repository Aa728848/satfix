# 构建产物（Windows 侧）
satfix-win/build/
satfix-win/dist/
# plugin\ 是链接用的工作目录：清单与 defaults\ 是**源码**（要提交），
# config\、logs\、satfix.dll 是运行时产物（不提交）。
satfix-win/plugin/logs/
satfix-win/plugin/config/
satfix-win/plugin/satfix.dll

# Windows 侧测试/插件产物
*.dll
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.exe

# Linux 侧构建产物
*.so
*.o
satfix/test/abi_check
satfix/test/libmock_stellaris.so
satfix/test_stl_fix

# 游戏自己的文件（不随仓库分发）
*.log
*.sav
*.png

# Python
__pycache__/
*.pyc

# 编辑器 / 系统
.vs/
.idea/
.vscode/
Thumbs.db
desktop.ini

# Linux 侧 hooklib 的构建产物（无扩展名，靠上面 *.so 之类的规则漏掉了）
hooklib/debug_hook
hooklib/test_shk
hooklib/test/fake_game
hooklib/test/test_preload.so
